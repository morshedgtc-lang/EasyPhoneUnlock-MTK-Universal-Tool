# Copy to .env and fill in. NEVER commit the real .env.

# dev | prod  (prod refuses to start with weak/empty secrets below)
ENV=dev

# --- Database ---
# Dev (SQLite, zero setup):
DATABASE_URL=sqlite:///./backend/easyphoneunlock.db
# Prod (Postgres):
# DATABASE_URL=postgresql+psycopg2://epu:STRONGPASS@db:5432/epu

# --- JWT (REQUIRED in prod) ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_INSECURE_DEV_SECRET
ACCESS_TOKEN_TTL_MIN=60
REFRESH_TOKEN_TTL_DAYS=14
OPERATION_GRANT_TTL_SEC=300

# --- Admin bootstrap (REQUIRED in prod; must not be 'admin'/'admin123') ---
ADMIN_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- Payload vault (REQUIRED in prod) ---
PAYLOAD_DIR=./backend/vault
# Generate: python -m backend.core.vault keygen
PAYLOAD_ENC_KEY=

# --- CORS (REQUIRED in prod; explicit origins, comma-separated, never *) ---
# CORS_ORIGINS=https://panel.example.com

# --- Rate limiting ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MIN=15

# --- Credits ---
REGISTER_BONUS_CREDITS=10
